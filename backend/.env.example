# backend/.env.example
# Copy to backend/.env and fill in values.

DEBUG=true

# LLM provider: "anthropic" | "openai" | "ollama"
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Day-29: local Ollama provider (LLM_PROVIDER=ollama; no API key needed).
# Note: the backend reads these from the process environment; nothing
# loads backend/.env automatically, so set them in the shell that starts it.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120

# OpenSCAD CLI binary name/path (must be on PATH, or set an absolute path)
OPENSCAD_BINARY=openscad

# Directory for temp .scad/.stl files written during rendering
SCAD_TMP_DIR=/tmp/openbim-scad
