# backend/.env.example
# Copy to backend/.env and fill in values.

DEBUG=true

# LLM provider: "anthropic" | "openai"
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# OpenSCAD CLI binary name/path (must be on PATH, or set an absolute path)
OPENSCAD_BINARY=openscad

# Directory for temp .scad/.stl files written during rendering
SCAD_TMP_DIR=/tmp/openbim-scad
